{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythos.local/schemas/characters.schema.json",
  "title": "Character collection",
  "type": "array",
  "minItems": 10,
  "maxItems": 10,
  "items": {
    "type": "object",
    "additionalProperties": true,
    "required": ["id", "name", "role", "domain", "symbols", "fun_fact", "verified"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
      "name": { "type": "string", "minLength": 2 },
      "role": { "type": "string", "minLength": 3 },
      "domain": { "type": "array", "minItems": 1, "items": { "type": "string" } },
      "symbols": { "type": "array", "minItems": 1, "items": { "type": "string" } },
      "fun_fact": { "type": "string", "minLength": 20 },
      "verified": { "type": "boolean" }
    }
  }
}
