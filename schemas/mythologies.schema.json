{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythos.local/schemas/mythologies.schema.json",
  "title": "Mythology index",
  "description": "An array of mythology summaries. Numeric years exist only for sorting; all UI copy comes from the text fields.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": true,
    "required": [
      "id",
      "name",
      "region",
      "period_text",
      "earliest_record",
      "start_year",
      "end_year",
      "summary",
      "mvp",
      "sensitivity",
      "verified"
    ],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z_]+$" },
      "name": { "type": "string", "minLength": 2 },
      "region": {
        "type": "string",
        "enum": ["Middle East", "Africa", "Europe", "Asia", "Americas", "Oceania"]
      },
      "period_text": { "type": "string", "minLength": 3 },
      "earliest_record": { "type": "string", "minLength": 3 },
      "start_year": { "type": "integer" },
      "end_year": { "type": "integer" },
      "summary": { "type": "string", "minLength": 40 },
      "mvp": { "type": "boolean" },
      "sensitivity": { "type": "string", "enum": ["low", "medium", "high"] },
      "verified": { "type": "boolean" }
    }
  }
}
