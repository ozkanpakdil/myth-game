{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythos.local/schemas/saga.schema.json",
  "title": "Branching saga",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "tradition",
    "title",
    "subtitle",
    "tagline",
    "intro",
    "setting",
    "default_name",
    "name_suggestions",
    "start",
    "acts",
    "paths",
    "boons",
    "endings",
    "nodes"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "tradition": { "type": "string", "minLength": 3 },
    "title": { "type": "string", "minLength": 3 },
    "subtitle": { "type": "string", "minLength": 3 },
    "tagline": { "type": "string", "minLength": 3 },
    "intro": { "type": "string", "minLength": 120 },
    "setting": { "type": "string", "minLength": 3 },
    "default_name": { "type": "string", "minLength": 1, "maxLength": 24 },
    "name_suggestions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 24 }
    },
    "start": { "type": "string", "minLength": 1 },
    "acts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 3 }
        }
      }
    },
    "paths": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "title", "glyph", "blurb"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "title": { "type": "string", "minLength": 3 },
          "glyph": { "type": "string", "minLength": 1 },
          "blurb": { "type": "string", "minLength": 20 }
        }
      }
    },
    "boons": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "endings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "title", "rank", "blurb", "node"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "title": { "type": "string", "minLength": 3 },
          "rank": { "type": "string", "minLength": 3 },
          "blurb": { "type": "string", "minLength": 20 },
          "node": { "type": "string", "minLength": 1 }
        }
      }
    },
    "nodes": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "act", "chapter", "title", "location", "art", "artCaption", "text"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "act": { "type": "integer", "minimum": 1 },
        "chapter": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 3 },
        "location": { "type": "string", "minLength": 3 },
        "art": { "type": "string", "minLength": 1 },
        "artCaption": { "type": "string", "minLength": 3 },
        "text": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 40 }
        },
        "lore": {
          "type": "object",
          "additionalProperties": true,
          "required": ["title", "body", "source"],
          "properties": {
            "title": { "type": "string", "minLength": 3 },
            "body": { "type": "string", "minLength": 60 },
            "source": { "type": "string", "minLength": 3 }
          }
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["label", "to"],
            "properties": {
              "label": { "type": "string", "minLength": 3 },
              "to": { "type": "string", "minLength": 1 },
              "tag": { "type": "string" },
              "requires": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "anyFlags": { "type": "array", "items": { "type": "string" } },
                  "flags": { "type": "array", "items": { "type": "string" } },
                  "minStats": {
                    "type": "object",
                    "additionalProperties": { "type": "integer", "minimum": 0 }
                  }
                }
              },
              "effects": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "add": {
                    "type": "object",
                    "additionalProperties": { "type": "integer" }
                  },
                  "set": {
                    "type": "object",
                    "additionalProperties": { "type": ["boolean", "string", "number"] }
                  }
                }
              }
            }
          }
        },
        "ending": {
          "type": "object",
          "additionalProperties": true,
          "required": ["id", "title", "rank", "summary"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 3 },
            "rank": { "type": "string", "minLength": 3 },
            "summary": { "type": "string", "minLength": 40 }
          }
        }
      }
    }
  }
}
